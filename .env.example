# Optional environment variables (names only). No secrets are needed to run
# the skeleton. The server reads these from the process environment; it does
# not load a .env file by itself, so set them in your shell if you need them.
#
# Path to the game config file (default: config/game.json)
ASCENT_CONFIG=
# Interface the server listens on (default: 127.0.0.1)
ASCENT_HOST=
# Port the server listens on (default: 8001)
ASCENT_PORT=
# Testing only: set to 1 to enable the "rectangle" cheat code (+5.00x in flight).
# Leave unset anywhere real; when unset the cheat endpoint does not exist.
ASCENT_DEV_CHEATS=
