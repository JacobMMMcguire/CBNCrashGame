# Copy this file to .env and edit it:   Copy-Item .env.example .env
# The server loads .env at startup. Variables already set in your shell win.
# .env is git-ignored. Never commit real keys. Nothing here is a secret yet.

# ---- Where the server listens ----
# 0.0.0.0 listens on every network interface so phones on the same Wi-Fi can
# connect. Use 127.0.0.1 to keep the server on this machine only.
ASCENT_HOST=0.0.0.0
# Port (default 8001)
ASCENT_PORT=8001
# Path to the game rules file (default: config/game.json)
ASCENT_CONFIG=

# ---- Single-player storage (PostgreSQL / Supabase) ----
# PostgreSQL (Supabase) connection string. When set, accounts, bets, finished
# rounds and idempotency keys are stored there and survive restarts; when empty,
# everything stays in memory. On Supabase use the Session pooler URI (port 5432,
# user postgres.<project-ref>): Render cannot reach the IPv6-only direct host.
DATABASE_URL=
# Testing only: a throwaway database for backend/tests/test_postgres.py.
# The tests drop and recreate the tables, so never point this at Supabase.
TEST_DATABASE_URL=
# Testing only: set to 1 to enable the "rectangle" cheat code (+5.00x in flight).
# Leave unset anywhere real; when unset the cheat endpoint does not exist.
ASCENT_DEV_CHEATS=

# ---- Multiplayer ----
# The address phones use to reach this server. The join link and QR code are
# built from it. Locally, use your laptop's LAN IP (ipconfig -> IPv4 Address),
# e.g. http://192.168.1.23:8001. When hosted, use the public https:// address.
PUBLIC_BASE_URL=http://localhost:8001
# How long (seconds) a dropped player's seat and balance are held for them
SEAT_HOLD_SECONDS=120
# Most players one room accepts
MAX_PLAYERS_PER_ROOM=50

# ---- Room storage (multiplayer rooms, players, money event log) ----
# Separate from DATABASE_URL above. sqlite (default, one local file),
# memory (lost on restart), supabase (not built yet).
STORAGE_BACKEND=sqlite
# SQLite file, relative to the repository root (default: data/ascent.sqlite3)
SQLITE_PATH=data/ascent.sqlite3
# Supabase placeholders for room storage, for later. Leave empty. Put real values only in .env.
SUPABASE_URL=
SUPABASE_KEY=
