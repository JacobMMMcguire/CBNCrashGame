# Optional environment variables (names only). No secrets are needed to run
# the skeleton. The server reads these from the process environment; it does
# not load a .env file by itself, so set them in your shell if you need them.
#
# Path to the game config file (default: config/game.json)
ASCENT_CONFIG=
# Interface the server listens on (default: 127.0.0.1)
ASCENT_HOST=
# Port the server listens on (default: 8001)
ASCENT_PORT=
# PostgreSQL (Supabase) connection string. When set, accounts, bets, finished
# rounds and idempotency keys are stored there and survive restarts; when empty,
# everything stays in memory. On Supabase use the Session pooler URI (port 5432,
# user postgres.<project-ref>): Render cannot reach the IPv6-only direct host.
DATABASE_URL=
# Testing only: a throwaway database for backend/tests/test_postgres.py.
# The tests drop and recreate the tables, so never point this at Supabase.
TEST_DATABASE_URL=
# Testing only: set to 1 to enable the "rectangle" cheat code (+5.00x in flight).
# Leave unset anywhere real; when unset the cheat endpoint does not exist.
ASCENT_DEV_CHEATS=
