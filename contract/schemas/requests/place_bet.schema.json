{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requests/place_bet.schema.json",
  "additionalProperties": false,
  "properties": {
    "wager": {
      "examples": [
        "100.00"
      ],
      "pattern": "^\\d{1,9}\\.\\d{2}$",
      "title": "Wager",
      "type": "string"
    },
    "autoCashOut": {
      "anyOf": [
        {
          "description": "Two decimals, floored",
          "minimum": 1.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Autocashout"
    }
  },
  "required": [
    "wager"
  ],
  "title": "PlaceBetRequest",
  "type": "object"
}
