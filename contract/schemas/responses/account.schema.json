{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "responses/account.schema.json",
  "additionalProperties": false,
  "properties": {
    "accountId": {
      "pattern": "^acc_[A-Za-z0-9]+$",
      "title": "Accountid",
      "type": "string"
    },
    "playerId": {
      "pattern": "^p_[0-9a-f]{10}$",
      "title": "Playerid",
      "type": "string"
    },
    "name": {
      "maxLength": 16,
      "minLength": 2,
      "title": "Name",
      "type": "string"
    },
    "balance": {
      "examples": [
        "100.00"
      ],
      "pattern": "^\\d{1,9}\\.\\d{2}$",
      "title": "Balance",
      "type": "string"
    },
    "currency": {
      "const": "credits",
      "title": "Currency",
      "type": "string"
    },
    "language": {
      "title": "Language",
      "type": "string"
    }
  },
  "required": [
    "accountId",
    "playerId",
    "name",
    "balance",
    "currency",
    "language"
  ],
  "title": "AccountResponse",
  "type": "object"
}
